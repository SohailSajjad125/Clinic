# 'production' (default) refuses weak secrets, hides API docs and turns HSTS on. Use 'development' on your own machine only.
ENVIRONMENT=development
# Production: use TLS, e.g. ...@db.example.com:5432/clinicos?sslmode=require, and a least-privilege role.
DATABASE_URL=postgresql+psycopg://clinicos:CHANGE_ME@localhost:5432/clinicos
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Groq (Groq). Keep server-side only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
APP_URL=http://localhost:3001
STORAGE_DIR=./storage
# Email (any SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ClinicOS <no-reply@yourdomain.com>
# SMS / WhatsApp via Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
RUN_SCHEDULER=1
# Key used to encrypt API keys/passwords saved from the admin panel. Set a separate random value in production
# (python -c "import secrets; print(secrets.token_urlsafe(48))"). If unset, JWT_SECRET is used, so changing JWT_SECRET would make saved keys unreadable.
SETTINGS_ENCRYPTION_KEY=
